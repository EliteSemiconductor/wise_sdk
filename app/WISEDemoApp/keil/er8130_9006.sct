;*****************************************************************************
; Scatter file for WISEDemoApp (demo_cli) - ER8130 / subg_soc_9006
; ARM Compiler 6 (armclang) / Keil uVision.
;
; Same memory map as app/project_template/keil/er8130_9006.sct, plus a dedicated
; ER_SHELL_CMDS region that collects the .shell_cmds command table emitted by the
; SHELL_CMD_AUTO() macro (middleware/wise_shell_v2). The region's Base/Limit are
; mapped to __shell_cmds_start/_end in shell.c under __ARMCC_VERSION.
;
;   FLASH : 0x00000000, length 0x0002E000 (184 KB)
;   RAM   : 0x20000000, length 0x00010000 ( 64 KB), DMA limited to first 48 KB
;   __HEAP_SIZE = 0x4000 (16 KB), __STACK_SIZE = 0x800 (2 KB)
;*****************************************************************************

LR_ROM 0x00000000 0x0002E000
{
    ; ---- Code & read-only data in FLASH ----
    ER_ROM 0x00000000 0x0002E000
    {
        *(.vectors, +First)         ; CMSIS C vector table (__Vectors)
        *(InRoot$$Sections)         ; C library / scatter-load code that must stay in root
        .ANY (+RO)                  ; all other code + rodata
    }

    ; ---- Shell command table (SHELL_CMD_AUTO -> .shell_cmds), in FLASH ----
    ; Named selector wins over ER_ROM's .ANY(+RO); Base/Limit bound the table.
    ER_SHELL_CMDS +0
    {
        *(.shell_cmds)
    }

    ; ---- Initialised data (.data) and zero-init (.bss) ----
    RW_IRAM1 0x20000000
    {
        .ANY (+RW +ZI)
    }

    ; ---- DMA pool (must remain within the first 48 KB of RAM) ----
    RW_DMA +0 ALIGN 4
    {
        *(.dma_data)                ; initialised DMA data (copied from flash)
        *(.dma_pool)                ; zero-init DMA buffers
        *(.dma_buffer)
    }
    ScatterAssert(ImageLimit(RW_DMA) <= 0x2000C000)   ; 48 KB DMA boundary

    ; ---- RAM functions: stored in flash, executed from RAM (.ram_text) ----
    ER_RAMTEXT +0 ALIGN 16
    {
        *(.ram_text)
    }

    ; ---- Heap then stack at the top of RAM ----
    ARM_LIB_HEAP  +0 EMPTY 0x00004000 { }            ; __HEAP_SIZE,  grows up
    ScatterAssert(ImageLimit(ARM_LIB_HEAP) <= 0x2000F800)

    ARM_LIB_STACK 0x20010000 EMPTY -0x00000800 { }   ; __STACK_SIZE, grows down from top of RAM
}
